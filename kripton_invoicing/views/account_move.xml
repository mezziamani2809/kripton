<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem name="Stornorechnung"
              id="menu_stornorechnungs"
              groups="sales_team.group_sale_manager"
              sequence="1"

              web_icon="kripton_base,static/description/account.png"
              action="account.action_move_out_refund_type"
    />
    <record id="account.action_move_out_refund_type" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
        <field name="name">Stornorechnung</field>
    </record>
    <record id="kripton_view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="invoice_number"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='journal_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='journal_div']" position="replace">
                <div name="journal_div" class="d-flex"
                     invisible="context.get('default_journal_id') and context.get('move_type', 'entry') != 'entry'"
                     groups="account.group_account_readonly">
                    <field name="journal_id" options="{'no_create': True}"
                           invisible="1"/>
                    <field name="currency_id" groups="base.group_multi_currency"
                           invisible="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="contact_id"/>
                <field name="gutschrift_j"/>
                <field name="gutschrifthays"/>
                <field name="vendor_id" invisible="1"/>
                <field name="tcs" invisible="1"/>
                <field name="is_employee" invisible="1"/>
                <field name="employee_id" attrs="{'invisible': [('is_employee', '=', False)]}"/>
                <field name="journal_id" string="Invoice Type" invisible="1"/>
                <field name="timesheets_attachment" widget="many2many_binary" class="oe_inline" string="Invoice"
                       attrs="{'invisible': [('gutschrift_j', '!=', True),('gutschrifthays', '!=', True)]}"/>
                <field name="invoice_number_bill" string="Invoice Number"
                       attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))]}"/>
                <field name="to_check" invisible="1"/>
                <field name="invoice_send" string="Sending the invoice" invisible="1"/>
                <field name="service_contract" invisible="1"/>
<!--                       attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>-->
                <field name="multi_vendor_id" widget="many2many_tags" invisible="0" string="Consultants" attrs="{'invisible': [('move_type', 'in', ('in_invoice', 'in_refund', 'in_receipt'))]}"/>

            </xpath>
            <xpath expr="//header/field[@name='state']" position="after">
                <field name="status" widget="statusbar" statusbar_visible="draft,posted,sent"
                       attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"/>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='vendor_id']" position="before">
                <field name="multi_vendor_id" widget="many2many_tags" invisible="1" string="Consultants"
                />
            </xpath>
            <xpath expr="//field[@name='payment_reference']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@id='other_tab']//label[@for='ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@id='other_tab']//field[@name='ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_payment_term_id']/parent::div" position="after">
                <field name="end_date_timesheets" invisible="0"/>
                <field name="vendor_id" invisible="1"/>
                <field name="is_move_sent" invisible="1"/>
                <field name="invoices_form" widget="radio"
                       attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
                <field name="invoice_attachment" invisible="1"/>
                <field name="doc_attachment_name" invisible="1"/>
                <field name="doc_attachment_id" class="oe_inline" filename="doc_attachment_name"
                       widget="drag_and_drop"
                       attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
                <field name="ausgangsrechnungen_date"  attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}" widget='month_year_format'/>

            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="after">
                <field name="service_type" invisible="1"/>
                <field name="vendor_id" string="Consultant" force_save="1" invisible="1"/>
                <field name="end_date_timesheet" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="before">
                <field name="tcs_ba_id" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_invoice_sent']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_invoice_sent']" position="after">
                <button name="action_print_new" string="Print"
                        class="btn btn-primary o_invisible_modifier"
                        type="object"/>
            </xpath>
        </field>
    </record>
    <!--    Réunion 25/09/23-->
    <record id="sapres_view_out_invoice_tree" model="ir.ui.view">
        <field name="name">account.out.invoice.tree.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <header>
                <button name="action_attachments_download" string="Download Attachments" type="object"/>
                <button name="%(kripton_invoicing.add_doc_attachment)d" string="Add Accounting"
                        type="action"/>
                <button name="%(kripton_invoicing.add_paid)d" string="Paid Combinations"
                        type="action"/>
            </header>
            <xpath expr="//field[@name='name']" position="after">
                <field name="invoice_number"
                       attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>

            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_total_in_currency_signed']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_untaxed_signed']" position="attributes">
                <attribute name="string">Net Amount</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="before">
                <field name="multi_vendor_id" widget="many2many_tags" invisible="0" string="Consultants"
                       attrs="{'invisible': [('move_type', 'in', ('in_invoice', 'in_refund', 'in_receipt'))]}"/>
                <field name="doc_attachment_id" class="oe_inline" filename="doc_attachment_name"
                       widget="drag_and_drop"/>
                <field name="doc_attachment_name" invisible="1"/>

            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="invoice_send" string="Sending the invoice" widget="boolean_toggle"/>
                <field name="status" attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}" widget="badge"
                       decoration-success="state == 'posted'" decoration-info="state == 'draft'" optional="show"/>
                <button string="paid" type="object" class="btn btn-primary o_list_button_add"
                        context="{'dont_redirect_to_payments': True}" groups="account.group_account_invoice"
                        attrs="{'invisible': ['|', '|', ('state', '!=', 'posted'), ('payment_state', 'not in', ('not_paid', 'partial')), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}"
                        name="action_register_payment"/>


            </xpath>
        </field>
    </record>
    <record id="sapres_view_in_invoice_bill_tree" model="ir.ui.view">
        <field name="name">account.out.invoice.tree.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="before">
                <field name="end_date_timesheets" invisible="1"/>
                <field name="timesheets_attachment" widget="many2many_binary" class="oe_inline" string="Invoice"/>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_total_in_currency_signed']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_untaxed_signed']" position="attributes">
                <attribute name="string">Net Amount</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="string">State</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="to_check" string="Verified"/>
                <field name="invoice_send" string="Sending the invoice"/>

                <field name="payment_state" optional="show" decoration-info="payment_state in ('partial','in_payment')"
                       decoration-success="payment_state == 'paid'"
                       decoration-danger="payment_state in ('reversed','not_paid')" widget="badge"/>
            </xpath>
        </field>
    </record>
    <record id="sapresview_account_payment_register_form" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.payment</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="invisible">1</attribute>

            </xpath>
            <xpath expr="//field[@name='journal_id']" position="after">
                <label for="amount"
                       attrs="{'invisible': ['|', ('can_edit_wizard', '=', False), '&amp;', ('can_group_payments', '=', True), ('group_payment', '=', False)]}"/>
                <div name="amount_div" class="o_row"
                     attrs="{'invisible': ['|', ('can_edit_wizard', '=', False), '&amp;', ('can_group_payments', '=', True), ('group_payment', '=', False)]}">
                    <field name="amount"/>
                    <field name="currency_id" required="1" options="{'no_create': True, 'no_open': True}"
                           groups="base.group_multi_currency"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='communication']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='group2']" position="replace">
                <group name="group2">

                    <field name="payment_date"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_move_line_tree" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree_grouped"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="vendor_id"/>
            </xpath>
        </field>

    </record>
    <record id="sapres_view_account_invoice_filter" model="ir.ui.view">
        <field name="name">account.move.inherit.invoice.filter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='salesperson']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='status']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='sales_channel']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='edi_state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='salesperson']" position="after">
                <filter string="Consultants" name="consultants" context="{'group_by':'multi_vendor_id'}"/>
                <filter string="Customer" name="customer" context="{'group_by':'partner_id'}"/>
            </xpath>
        </field>
    </record>
    <record id="sapres_action_move_out_invoice_type" model="ir.actions.act_window">
        <field name="name">Gutschrift</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', '=', 'out_invoice'),('gutschrifthays', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a customer invoice
            </p>
            <p>
                Create invoices, register payments and keep track of the discussions with your customers.
            </p>
        </field>
    </record>
    <menuitem name="Gutschrift"
              id="menu_action_move_out_invoice_type_"
              groups="sales_team.group_sale_manager"
              sequence="1"
              web_icon="kripton_base,static/description/account.png"
              action="sapres_action_move_out_invoice_type"
    />
    <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
        <field name="domain">[('move_type', '=', 'out_invoice'),('gutschrifthays', '=', False)]</field>
    </record>
</odoo>
