<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="account.document_tax_totals">
        <tr class="border-black o_total">
            <td>
                <strong>Net Amount</strong>
            </td>
            <td class="text-right">
                <span t-field="docs.amount_untaxed"/>
                <span t-field="docs.currency_id.symbol"/>
            </td>
        </tr>
        <tr class="border-black o_total">
            <td>
                <strong>VAT 0%</strong>

            </td>
            <td class="text-right">
                <span t-field="docs.amount_tax"/>
                <span t-field="docs.currency_id.symbol"/>
            </td>
        </tr>
        <tr class="border-black o_total" t-if="docs.discount_amount != 0">
            <td>
                <strong>Total with Discount</strong>
            </td>
            <td class="text-right">
                <span t-field="docs.amount_total_signed"/>
                <span t-field="docs.currency_id.symbol"/>
            </td>
        </tr>
        <tr class="border-black o_total" t-if="docs.discount_amount != 0">
            <td>
                <strong>Discount</strong>
                <span t-field="docs.discount_amount"/>%
            </td>
            <td class="text-right">
                <span t-field="docs.total_discount"/>
                <span t-field="docs.currency_id.symbol"/>
            </td>
        </tr>
        <tr class="border-black o_total">
            <td>
                <strong>Total</strong>
            </td>
            <td class="text-right">
                <span t-esc="tax_totals['formatted_amount_total']"/>
            </td>
        </tr>

    </template>
    <template id="invoice_report_inherit_id" inherit_id="account.report_invoice_document">
        <xpath expr="//table[@name='invoice_line_table']" position="before">
            <table style="width:100%; margin-left: 10px border-left: 1px solid black; table-layout: fixed;">
                <colgroup>
                    <col style="width: 20%;"/>
                    <col style="width: 30%;"/>
                    <col style="width: 25%;"/>
                    <col style="width: 25%;"/>
                </colgroup>
                <tr>
                    <th>
                        <b>Bill to :</b>
                    </th>
                    <th>
                        <span t-field="o.partner_id.name"/>
                    </th>
                    <th>INVOICE :</th>
                    <th>
                        <span t-field="o.invoice_number"/>
                    </th>
                </tr>
                <tr>
                    <th>Contract N° :</th>
                    <th>
                        <span t-field="o.ref"/>

                    </th>
                    <th>INVOICE DATE :</th>
                    <th>
                        <t t-if="o.invoice_date">
                            <span t-field="o.invoice_date"/>
                        </t>
                    </th>
                </tr>
                <tr>
                    <th>Contact :</th>
                    <th>
                        <span t-field="o.contact_id.name"/>
                    </th>

                    <th>
                        <b>E-mail :</b>
                    </th>
                    <th>
                        <span>s.benyedder@sapres.de</span>
                    </th>
                </tr>
                <tr>
                    <th>
                        <b>Adresse :</b>
                    </th>

                    <th>
                        <t t-if="o.partner_id.street">
                            <span t-field="o.partner_id.street"/>
                        </t>
                        <br/>
                        <t t-if="o.partner_id.street2">
                            <span t-field="o.partner_id.street2"/>
                        </t>                        <br/>

                        <t t-if="o.partner_id.zip">
                            <span t-field="o.partner_id.zip"/>
                        </t>
                        <t t-if="o.partner_id.city">
                            <span t-field="o.partner_id.city"/>
                        </t>
                    </th>
                    <th>
                        <b>Contact :</b>
                        <br/>
                        <b>Tel :</b>
                        <br/>

                        <b>Tax number :</b>
                    </th>
                    <th>
                        <span>Slim Ben Yedder
                        </span>
                        <br/>
                        <span>+4917670799232</span>
                        <br/>
                        <span>DE321097474</span>

                    </th>
                </tr>

            </table>
            <br/>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="replace">
            <table class="table table-sm o_main_table" name="invoice_line_table">
                <thead>
                    <tr>
                        <th name="th_description" class="text-left">
                            <span>Description</span>
                        </th>
                        <th name="th_service_type" class="text-left">
                            <span></span>
                        </th>
                        <th name="th_service_type" class="text-left">
                            <span>Consultant</span>
                        </th>
                        <th name="th_service_type" class="text-left">
                            <span>Date</span>
                        </th>
                        <th name="th_quantity" class="text-right">
                            <span>Quantity</span>
                        </th>
                        <th name="th_priceunit"
                            t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>Unit Price</span>
                        </th>
                        <th name="th_subtotal" class="text-right">
                            <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>
                            <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="invoice_tbody">
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-set="lines"
                       t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                    <t t-foreach="lines" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                           groups="account.group_show_line_subtotals_tax_excluded"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                           groups="account.group_show_line_subtotals_tax_included"/>

                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="not line.display_type" name="account_invoice_line_accountable">
                                <td name="account_invoice_line_name">
                                    <span t-field="line.product_id.name" t-options="{'widget': 'text'}"/>
                                </td>
                                <td name="account_invoice_line_name">
                                    <t t-if="line.service_type == 'site'">
                                        <span>On Site</span>
                                    </t>
                                    <t t-if="line.service_type == 'romote'">
                                        <span>Remote</span>
                                    </t>
                                </td>
                                <td name="account_invoice_line_name">
                                    <t t-if="line.end_date">
                                        <span t-field="line.end_date.name"/>
                                    </t>
                                </td>
                                <td name="account_invoice_line_name">
                                    <span t-field="line.start_date" t-options='{"format": "MMM Y"}'/>
                                </td>
                                <td class="text-right">
                                    <span t-field="line.quantity"/>
                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                </td>
                                <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span class="text-nowrap" t-field="line.price_unit"/>
                                </td>
                                <td class="text-right o_price_total">
                                    <span class="text-nowrap" t-field="line.price_subtotal"
                                          groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <span class="text-nowrap" t-field="line.price_total"
                                          groups="account.group_show_line_subtotals_tax_included"/>
                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                </td>
                            </t>
                        </tr>
                        <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-right">
                                <td colspan="99">
                                    <strong class="mr16">Subtotal</strong>
                                    <span
                                            t-esc="current_subtotal"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                    />
                                </td>
                            </tr>
                        </t>
                    </t>


                </tbody>
            </table>
        </xpath>
        <xpath expr="//p[@name='payment_communication']" position="replace">
            <p t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference" name="payment_communication">
                VAT amount: Not charged. Reverse charge applies.
                <b>
                    <br/>

                </b>
            </p>
        </xpath>
        <xpath expr="//p[@name='payment_term']" position="replace">
            <p t-if="o.move_type in ('out_invoice', 'in_refund') and o.company_id" name="payment_communication">
                Payment terms:

                <span t-field="docs.invoice_payment_term_id.name"/>

            </p>
            <br/>
            <table>
                <tr>

                    <th>
                        Company :
                        <br/>
                        Bank :
                        <br/>
                        IBAN :
                        <br/>
                        BIC :
                    </th>
                    <th>
                        <span t-field="docs.company_id.name"/>
                        <br/>
                        <span t-field="docs.company_id.bank"/>
                        <br/>
                        <span t-field="docs.company_id.iban"/>
                        <br/>
                        <span t-field="docs.company_id.bic"/>
                    </th>
                </tr>
            </table>
            <table style="width:100%; border-left: 1px;">
                <tr>
                    <th style="width:30%; border-left: 1px;">
                        <h2>
                            <br/>
                        </h2>
                    </th>
                    <th style="width:30%; border-left: 1px;">
                        <h2>
                            <br/>
                        </h2>
                    </th>
                    <th style="width:60%; border-left: 1px;">
                        With best wishes
                        <br/>
                        Slim Ben Yedder
                        <br/>
                        Managing Director
                        <br/>
                        Sapres Technologies GmbH
                    </th>
                </tr>
            </table>

        </xpath>
    </template>
    <template id="external_layout_din5008_report_inherit_id" inherit_id="l10n_de.external_layout_din5008">
        <xpath expr="//table[hasclass('company_header')]" position="replace">
            <table class="company_header" t-att-style="'height: %dmm;' % (din_header_spacing or 27)">
                <tr>
                    <th style="width:30%;">
                        <div style="padding-top: 40px;">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                 style="width: 200px;" alt="Logo"/>
                        </div>
                    </th>

                    <th style="width:20%;">
                        <h2>
                            <br/>
                        </h2>
                    </th>
                    <th style="width:50%;">
                        <div style="padding-top: 40px; margin-left: 100px">

                        </div>
                    </th>
                </tr>
                <tr style="padding-top: 20px; margin-left: (0px">
                    <th>
                        <div style="font-size:12px">
                            <t t-if="company.name">
                                <span t-field="company.name"/>
                            </t>
                            <br/>
                            <t t-if="company.street">
                                <span t-field="company.street"/>
                            </t>
                            <br/>
                            <t t-if="company.street2">
                                <span t-field="company.street2"/>
                            </t>
                            <t t-if="company.zip">
                                <span t-field="company.zip"/>
                            </t>
                            <t t-if="company.city">
                                <span t-field="company.city"/>
                            </t>

                        </div>

                    </th>
                    <th>
                    </th>
                    <th>
                        <h4>
                            <div>
                                <b style="font-size:20px">INVOICE :</b>
                                <b t-field="o.invoice_number" style="font-size:20px"/>
                            </div>

                        </h4>

                    </th>
                </tr>

            </table>
        </xpath>
        <xpath expr="//div[hasclass('text-muted')]" position="replace">
            <div class="text-muted">
            </div>
        </xpath>
        <xpath expr="//div[2]/table" position="replace">
            <h3>
                <br/>
            </h3>

        </xpath>
        <xpath expr="//div[2]/h2" position="replace">
        </xpath>
        <xpath expr="//div[hasclass('company_details')]" position="replace">
            <h2>
                <br/>
            </h2>
            <div class="company_details">
                <table style="width:100%; margin-left: 10px border-left: 1px">
                    <tr>
                        <th>
                            <ul class="list-inline">
                                <li t-if="company.name">
                                    <span t-field="company.name"/>
                                </li>
                                <li t-if="company.street">
                                    <span t-field="company.street"/>
                                </li>
                                <li>
                                    <span t-field="company.street2"/>
                                    <span t-if="company.zip" t-field="company.zip"/>
                                    <span t-if="company.city" t-field="company.city"/>
                                </li>

                            </ul>
                        </th>
                        <th>
                            <ul class="list-inline">

                                <li t-if="company.phone">
                                    <span style="text-align: center;">PostBank</span>
                                </li>

                                <li t-if="company.iban">
                                    <span>IBAN :</span>
                                    <span t-if="company.iban" t-field="company.iban"/>

                                </li>
                                <li t-if="company.bic">
                                    <span>BIC SWIFT :</span>
                                    <span t-if="company.bic" t-field="company.bic"/>
                                </li>
                            </ul>
                        </th>
                        <th>
                            <ul class="list-inline">
                                <li t-if="company.vat"><t
                                        t-esc="company.account_fiscal_country_id.vat_label or 'Tax ID'"/>:
                                    <span t-field="company.vat"/>
                                </li>
                                <li>TAX ID:
                                    <span>007 243 07966</span>
                                </li>
                                <li>USt-IdNr:
                                    <span>DE321097474</span>
                                </li>
                                <div t-field="company.report_footer"/>
                            </ul>
                        </th>
                    </tr>
                </table>
            </div>

        </xpath>
    </template>

</odoo>

