<?xml version="1.0"?>
<odoo>
    <record model='ir.ui.view' id='attachment_view'>
        <field name="name">sapres.document.document.form</field>
        <field name="model">attachment.doc.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Attachment">
                <group>
                    <field name="attachment_ids" widget="many2many_binary" class="oe_inline" invisible="1"/>
                    <field name="document_ref" widget="many2one"/>


                </group>
                <footer>
                    <button string="Add attachment" type="object" name="add_doc_attachment_all"
                            class="btn btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>

            </form>
        </field>
    </record>
    <record model='ir.ui.view' id='paid_view'>
        <field name="name">paid.account.move.form</field>
        <field name="model">paid.account.move</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Analyse" type="object" name="add_paid_account" class="btn btn-primary"  attrs="{'invisible': [('results', '!=', False)]}"/>
                </header>
                <group>

                    <field name="amount"/>
                    <field name="results" readonly="1"/>
                </group>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>

            </form>
        </field>
    </record>
    <record id="add_doc_attachment" model="ir.actions.act_window">
        <field name="name">Add Accounting</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">attachment.doc.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="kripton_invoicing.attachment_view"/>
        <field name="target">new</field>
    </record>
    <record id="add_paid" model="ir.actions.act_window">
        <field name="name">Paid Combinations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">paid.account.move</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="kripton_invoicing.paid_view"/>
        <field name="target">new</field>
    </record>

</odoo>
