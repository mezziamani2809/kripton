<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_order_form_inherit_contract" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.contract</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
        <xpath expr="//header" position="inside">
            <button name="action_force_end_contract"
                    string="End Contract"
                    type="object"
                    class="btn-secondary"
                    attrs="{'invisible': [('state', '!=', 'sale')]}"
                    confirm="Are you sure you want to end this contract immediately?"/>
        </xpath>
    </field>
</record>
</odoo>
