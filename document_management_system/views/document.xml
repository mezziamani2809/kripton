<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_document_open" model="ir.actions.act_window">
        <field name="name">Accounting</field>
        <field name="res_model">document.document</field>
        <field name="view_mode">tree</field>
        <field name="domain">[]</field>
    </record>

    <record id="view_document_search" model="ir.ui.view">
        <field name="name">Accounting Search</field>
        <field name="model">document.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="parent_id"/>
                <filter name="filter_is_root" string="Root" domain="[('parent_id', '=', False)]"/>
                <group>
                    <filter name="group_by_parent_id" string="Parent" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_document_tree" model="ir.ui.view">
        <field name="name">Accounting Tree</field>
        <field name="model">document.document</field>
        <field name="arch" type="xml">
            <tree export_xlsx="0">
                <button name="action"
                        type="object"
                        context="{'default_parent_id': id, 'search_default_parent_id': id, 'module_action_id': 'document_management_system.action_document_open'}"
                        icon="fa-solid fa-folder" class="folder"/>
                <field name="sequence" widget="handle" invisible="1"/>
                <field name="name" class="website_urls"/>
                <field name="full_name"/>
                <field name="old" invisible="1"/>

                <field name="parent_full_name" invisible="1"/>
                <field name="child_count" invisible="1"/>
                <field name="create_uid" invisible="1"/>
                <field name="create_date" invisible="1"/>
                <field name="write_uid" invisible="1"/>
                <field name="write_date" invisible="1"/>
                <button name="%(document_management_system.add_attachment)d"
                        string="Upload File"
                        type="action" context="{'default_document_ref': id}"
                        groups="document_management_system.group_document_manager"
                        class="btn btn-primary"
                />
            </tree>
        </field>
    </record>

