    <record id="view_document_form" model="ir.ui.view">
        <field name="name">Accounting Form</field>
        <field name="model">document.document</field>
        <field name="arch" type="xml">
            <form class="o_form_document">
                <header>
                    <button name="%(document_management_system.add_attachment)d" string="Add Accounting"
                            type="action" context="{'default_document_ref': id}"
                            groups="document_management_system.group_document_manager"
                    />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button class="oe_stat_button" name="document_view_" type="object" icon="fa-list-ol">
                            <field string="Accounting" name="document_count" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <label for="description" class="oe_edit_only" invisible="1"/>
                    <field name="description" invisible="1"/>
                    <separator/>
                    <label for="content" class="oe_edit_only" invisible="1"/>
                    <field name="content" invisible="1"/>
                    <separator/>
                    <field name="document_management" string="Accounting" invisible="1"/>
                    <field name="child_ids" context="{'default_parent_id': id}">
                        <tree>
                            <field name="name"/>
                        </tree>
                    </field>
                    <group>
                        <group>
                            <field name="parent_id" options="{'no_create': True}" domain="[('id', '!=', id)]"
                                   context="{'display_full_name': True}" invisible="1"/>
                        </group>
                        <group>
                            <field name="parent_full_name" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="create_uid" readonly="1" invisible="1"/>
                            <field name="write_uid" readonly="1" invisible="1"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1" invisible="1"/>
                            <field name="write_date" readonly="1" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_document_main" model="ir.actions.act_window">
        <field name="name">Accounting</field>
        <field name="res_model">document.document</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('old','=',False)]</field>
        <field name="context" eval="{'search_default_filter_is_root':1}"/>
    </record>
    <record id="action_document_main_old" model="ir.actions.act_window">
        <field name="name">Accounting Old</field>
        <field name="res_model">document.document</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('old','=',True)]</field>
        <field name="context" eval="{'search_default_filter_is_root':1}"/>
    </record>

    <menuitem id="menu_documents" sequence="6" groups="group_document_user" action="action_document_main"
              web_icon="document_management_system,static/description/documents.png"/>
    <menuitem id="menu_documents_old" sequence="7" groups="group_document_user"
              action="document_management_system.action_document_main_old"
              web_icon="document_management_system,static/description/documents.png"/>


    <record model='ir.ui.view' id='document_form_view'>
        <field name="name">sapres.document.document.form</field>
        <field name="model">sapres.document.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" invisible="1"/>
                            <field name="document_ref" invisible="1"/>
                            <field name="doc_attachment_id" class="oe_inline" filename="name" widget="drag_and_drop"/>
                            <!--                            <field name="document_ref" invisible="1"/>-->
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <record model='ir.ui.view' id='document_tree_view'>
        <field name="name">sapres.document.document.tree</field>
        <field name="model">sapres.document.document</field>
        <field name="arch" type="xml">
            <tree export_xlsx="0">
                <header>
                    <button name="action_attachments_download" string="Download Attachments" type="object"/>
                </header>
                <field name="row_number" invisible="0"/>
                <field name="create_date" widget="date"/>
                <field name="name" invisible="1"/>
                <field name="doc_attachment_id" class="oe_inline" filename="name" widget="binary"/>
            </tree>
        </field>
    </record>


    <record id="action_document_main_" model="ir.actions.act_window">
        <field name="name">Attachment</field>
        <field name="res_model">sapres.document.document</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
    </record>
</odoo>

