<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--    <field name="child_ids" mode="kanban" context="{'default_parent_id': active_id, 'default_street': street, 'default_street2': street2, 'default_city': city, 'default_state_id': state_id, 'default_zip': zip, 'default_country_id': country_id, 'default_lang': lang, 'default_user_id': user_id, 'default_type': 'other'}">-->

    <record id="view_partner_structured_form" model="ir.ui.view">
        <field name="name">view_partner_structured_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">990</field>
        <field name="arch" type="xml">
              <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group invisible="1">
                    <group>
                        <field name="supplier_rank"/>
                        <field name="customer_rank"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//page[@name='contact_addresses_']" position="attributes">
                <attribute name="attrs">{'invisible' : ['|',('final_customer_rank', '=', 1),('company_type', '=', 'person')]}</attribute>
            </xpath>
            <xpath expr="//page[@name='contact_addresses_']/field[@name='child_ids']" position="attributes">
                <attribute name="name">contacts_child_ids</attribute>
                <attribute name="context">{'default_is_company': True,'default_customer_rank':
                    1,'default_supplier_rank':
                    0,'default_parent_contacts_id':
                    active_id,'default_parent_id': active_id,
                    'default_street': street, 'default_street2':
                    street2, 'default_city': city, 'default_state_id': state_id, 'default_zip': zip,
                    'default_country_id': country_id, 'default_lang': lang, 'default_user_id': user_id, 'default_type':
                    'other'}
                </attribute>
            </xpath>

            <xpath expr="//page[@name='contact_addresses']" position="attributes">
                <attribute name="attrs">{'invisible' : ['|',('customer_rank', '>', 0),('company_type', '=', 'person')]}</attribute>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']/field[@name='child_ids']" position="attributes">
                <attribute name="name">consultants_child_ids</attribute>
                <attribute name="context">{'default_is_company': False,'default_supplier_rank':
                    1, 'default_customer_rank':
                    0, 'default_parent_consultants_id':
                    active_id,'default_parent_id': active_id,
                    'default_street': street, 'default_street2':
                    street2, 'default_city': city, 'default_state_id': state_id, 'default_zip': zip,
                    'default_country_id': country_id, 'default_lang': lang, 'default_user_id': user_id, 'default_type':
                    'other'}
                </attribute>

            </xpath>

            <xpath expr="//page[@name='contact_addresses_']" position="inside">
                <field name="child_ids" invisible="1"/>
            </xpath>

            <xpath expr="//page[@name='contact_addresses_']/field[@name='contacts_child_ids']/form" position="replace">
                <form string="Contact">
                    <sheet>
                        <!-- parent_id and type fields needed in attrs in base_address_city module which overwrites
                        _fields_view_get() of partner. It would be better to put those fields there but the web client
                        dosen't support when a field is displayed several times in the same view.-->
                        <field name="type" required="0" widget="radio" options="{'horizontal': true}"
                               invisible="1"/>
                        <field name="parent_id" invisible="1"/>
                        <div class="oe_title mb24">
                            <field name="is_company" invisible="1"/>
                            <field name="commercial_partner_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                            <field name="country_code" invisible="1"/>
                            <field name="final_customer_rank" invisible="1"/>
                            <field name="company_type" widget="radio" options="{'horizontal': true}"/>

                            <h1 invisible="0">
                                <field id="company" class="text-break" name="name" default_focus="1"
                                       placeholder="Name"
                                       attrs="{'required' : [('type', '=', 'contact'),('is_company', '=', True)], 'invisible': [('is_company','=', False)]}"/>
                                <field id="individual" class="text-break" name="name" default_focus="1"
                                       placeholder="Name"
                                       attrs="{'required' : [('type', '=', 'contact'), ('is_company', '=', False)], 'invisible': [('is_company','=', True)]}"/>
                                <!--                                 <field name="first_name"  attrs="{'required' : [('type', '=', 'contact'), ('is_company', '=', False)], 'invisible': [('is_company','=', True)]}"/>-->
                                <!--                        <field name="last_name"  attrs="{'required' : [('type', '=', 'contact'), ('is_company', '=', False)], 'invisible': [('is_company','=', True)]}"/>-->
                            </h1>
                        </div>
                        <hr/>
                        <group>
                            <group>
                                <!--                                        <field name="name" string="Contact Name"-->
                                <!--                                               attrs="{'required' : [('type', '=', 'contact')]}"/>-->
                                <field name="title" options="{'no_open': True}" placeholder="e.g. Mr."
                                       attrs="{'invisible': [('type','!=', 'contact')]}"/>
                                <field name="function" placeholder="e.g. Sales Director"
                                       attrs="{'invisible': [('type','!=', 'contact')]}"/>
                                <label for="street" string="Address"
                                       attrs="{'invisible': [('type','=', 'contact')]}"/>
                                <div attrs="{'invisible': [('type','=', 'contact')]}">
                                    <div class="o_address_format" name="div_address">
                                        <field name="street" placeholder="Street..." class="o_address_street"/>
                                        <field name="street2" placeholder="Street 2..."
                                               class="o_address_street"/>
                                        <field name="city" placeholder="City" class="o_address_city"/>
                                        <field name="state_id" class="o_address_state" placeholder="State"
                                               options="{'no_open': True, 'no_quick_create': True}"
                                               context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                        <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                        <field name="country_id" placeholder="Country" class="o_address_country"
                                               options='{"no_open": True, "no_create": True}'/>
                                    </div>
                                </div>
                            </group>
                            <group>
                                <field name="email" widget="email"/>
                                <field name="phone" widget="phone"/>
                                <field name="mobile" widget="phone"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="comment" placeholder="Internal notes..."/>
                        </group>
                        <field name="lang" invisible="True"/>
                        <field name="user_id" invisible="True"/>

                        <group invisible="1">
                            <group>
                                <field name="supplier_rank"/>
                                <field name="customer_rank"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </xpath>
            <xpath expr="//page[@name='contact_addresses']/field[@name='consultants_child_ids']/form"
                   position="replace">
                <form string="Consultant">
                    <sheet>
                        <!-- parent_id and type fields needed in attrs in base_address_city module which overwrites
                        _fields_view_get() of partner. It would be better to put those fields there but the web client
                        dosen't support when a field is displayed several times in the same view.-->
                        <field name="type" required="0" widget="radio" options="{'horizontal': true}"
                               invisible="1"/>
                        <field name="parent_id" invisible="1"/>
                        <div class="oe_title mb24">
                            <field name="is_company" invisible="1"/>
                            <field name="commercial_partner_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                            <field name="country_code" invisible="1"/>
                            <field name="company_type" widget="radio" options="{'horizontal': true}" invisible="1"/>

                            <h1 invisible="0">
                                <field id="company" class="text-break" name="name" default_focus="1"
                                       placeholder="Name"
                                       attrs="{'required' : [('type', '=', 'contact'),('is_company', '=', True)], 'invisible': [('is_company','=', False)]}"/>
                                <field id="individual" class="text-break" name="name" default_focus="1"
                                       placeholder="Name"
                                       attrs="{'required' : [('type', '=', 'contact'), ('is_company', '=', False)], 'invisible': [('is_company','=', True)]}"/>
                                <field name="first_name" placeholder="First Name"
                                       attrs="{'required' : [('type', '=', 'contact'), ('is_company', '=', False)], 'invisible': [('is_company','=', True)]}"/>
                                <field name="last_name" placeholder="Last Name"
                                       attrs="{'required' : [('type', '=', 'contact'), ('is_company', '=', False)], 'invisible': [('is_company','=', True)]}"/>
                            </h1>
                        </div>
                        <hr/>
                        <group>
                            <group>
                                <!--                                        <field name="name" string="Contact Name"-->
                                <!--                                               attrs="{'required' : [('type', '=', 'contact')]}"/>-->
                                <field name="title" options="{'no_open': True}" placeholder="e.g. Mr."
                                       attrs="{'invisible': [('type','!=', 'contact')]}"/>
                                <field name="function" placeholder="e.g. Sales Director"
                                       attrs="{'invisible': [('type','!=', 'contact')]}"/>
                                <label for="street" string="Address"
                                       attrs="{'invisible': [('type','=', 'contact')]}"/>
                                <div attrs="{'invisible': [('type','=', 'contact')]}">
                                    <div class="o_address_format" name="div_address">
                                        <field name="street" placeholder="Street..." class="o_address_street"/>
                                        <field name="street2" placeholder="Street 2..."
                                               class="o_address_street"/>
                                        <field name="city" placeholder="City" class="o_address_city"/>
                                        <field name="state_id" class="o_address_state" placeholder="State"
                                               options="{'no_open': True, 'no_quick_create': True}"
                                               context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                                        <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                        <field name="country_id" placeholder="Country" class="o_address_country"
                                               options='{"no_open": True, "no_create": True}'/>
                                    </div>
                                </div>
                            </group>
                            <group>
                                <field name="email" widget="email"/>
                                <field name="phone" widget="phone"/>
                                <field name="mobile" widget="phone"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="comment" placeholder="Internal notes..."/>
                        </group>
                        <field name="lang" invisible="True"/>
                        <field name="user_id" invisible="True"/>

                        <group invisible="1">
                            <group>
                                <field name="supplier_rank"/>
                                <field name="customer_rank"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </xpath>
        </field>
    </record>
    <menuitem id="kripton_base.menu_account_final_customer" parent="sale.sale_order_menu" name="End Clients"
              groups="sales_team.group_sale_manager"
              action="kripton_base.res_partner_action_final_customer"
              sequence="11"/>
    <menuitem id="kripton_base.menu_account_final_customer" parent="sale.sale_order_menu" name="End Clients"
              groups="sales_team.group_sale_manager"
              action="kripton_base.res_partner_action_final_customer"
              sequence="12"/>
    <menuitem name="End Clients"
              id="kripton_base.menu_account_final_customer_"
              groups="sales_team.group_sale_manager"
              sequence="18"
              web_icon="kripton_base,static/description/contacts.png"
              action="kripton_base.res_partner_action_final_customer"
    />
    <record id="kripton_base.res_partner_action_final_customer" model="ir.actions.act_window">
        <field name="name">End Clients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_final_customer': 1,'res_partner_search_mode': 'final_customer',
            'default_is_compfany': True, 'default_final_customer_rank': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new end client in your address book
            </p>
            <p>
                Odoo helps you easily track all activities related to an end client.
            </p>
        </field>
    </record>
    <record id="final_res_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.search.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="priority">99999</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='final_customer']" position="attributes">
                <attribute name="string">End Client</attribute>
                <separator/>
            </xpath>
        </field>
    </record>

            <record id="customer_partner_tree_inherit_id" model="ir.ui.view">
            <field name="name">res.partner.tree.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree//field['company_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
</odoo>
