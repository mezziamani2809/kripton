<odoo>
    <record id="account_move_eg_discount_form_view" model="ir.ui.view">
        <field name="name">account.move.eg.discount.form.view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_totals_json']" position="after">
                <field name="amount_total_signed" options="{'currency_field': 'currency_id'}" string="Total Without Discount"/>
                <field name="total_discount" options="{'currency_field': 'currency_id'}" string="Discount"/>
            </xpath>
        </field>
    </record>
       <record id="kripton_view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.eg.discount.form.view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="kripton_invoicing.kripton_view_move_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='service_contract']" position="after">
                        <field name="sale_order" invisible="1"/>
                        <field name="discount_method" invisible="1"/>
                        <field name="discount_amount"/>
            </xpath>
        </field>
    </record>
</odoo>

