<odoo>
    <record id="view_contract_end_wizard_form" model="ir.ui.view">
    <field name="name">contract.end.wizard.form</field>
    <field name="model">contract.end.wizard</field>
    <field name="arch" type="xml">
        <form string="Mettre fin au contrat">
            <group>
                <field name="end_date" />
            </group>
            <footer>
                <button name="action_confirm" string="Confirmer" type="object" class="btn-primary" data-hotkey="q"/>
                <button string="Annuler" class="btn-secondary" special="cancel" data-hotkey="x"/>
            </footer>
        </form>
    </field>
</record>

    <record id="view_order_form_inherit_contract_inherited" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.contract</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">999999999</field>
    <field name="arch" type="xml">
            <button name="action_force_end_contract" position="replace">
                    <button name="action_open_end_contract_wizard"
                    string="End Contract"
                    type="object"
                    class="btn-secondary"
                    attrs="{'invisible': [('state', '!=', 'sale')]}"
                    />
        </button>
    </field>
</record>
</odoo>