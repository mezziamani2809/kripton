<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_advance_payment_inv_inherit" model="ir.ui.view">
        <field name="name">sale.advance.payment.inv.form.inherit</field>
        <field name="model">sale.advance.payment.inv</field>
        <field name="inherit_id" ref="sale.view_sale_advance_payment_inv"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='date_start_invoice_timesheet']" position="attributes">
                <attribute name="string">Timesheets Period
                    (optional)</attribute>
            </xpath>
            <xpath expr="//field[@name='advance_payment_method']" position="after">
                <field name="po_required" invisible="1"/>
                <field name="po_id" domain="[('sale_id', '=', context.get('active_id'))]" options="{'no_create': True}"
                       attrs="{'invisible': [('po_required', '=', False)], 'required': [('po_required', '=', True)]}"/>

            </xpath>
        </field>
    </record>
</odoo>
