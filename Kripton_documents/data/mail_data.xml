<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Template for sale order due reminder-->
    <data noupdate="0">

        <!--        Template for invoice due reminder-->
        <record id="doc_template" model="mail.template">
            <field name="name">HR Employee Documents Email</field>
            <field name="model_id" ref="model_hr_employee_documents"/>
            <field name="email_from">erp@sapres.de</field>
            <field name="email_to">e.karoui@sapres.de</field>
            <field name="subject">HR Employee Documents Email</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <h4>
                            <b>Hello ,</b>
                        </h4>
                        <br/>
                        <span t-if="object.name">Documents Name</span>
                        <b>
                            <t t-out="object.name"/>
                        </b>
                        <br/>
                        <span t-if="object.date_from">Date :
                        </span>

                        <b>
                            <t t-out="object.date_from"/>
                        </b>
                        <br/>
                        <span t-if="object.employee_id.name">Employee :
                        </span>
                        <b>
                            <t t-out="object.employee_id.name"/>
                        </b>
                        <br/>
                        <span t-if="object.type_id.name">
                            Type :
                        </span>
                        <b>
                            <t t-out="object.type_id.name"/>
                        </b>
                        <br/>
                          <span t-if="object.description">
                            Description :
                        </span>
                        <b>
                            <t t-out="object.description"/>
                        </b>
                        <br/>
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>