<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Scheduled action for sale order due date reminder-->
    <data noupdate="1">

        <!--        Scheduled action for invoice due date reminder-->

        <record id="ir_cron_scheduler_recurring_action_due_client_contract" model="ir.cron">
            <field name="name">Client Contract : Due Reminder Email</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.action_send_mail_client_contract()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>
