<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Template for sale order due reminder-->
    <data noupdate="0">

        <!--        Template for invoice due reminder-->
        <record id="invoice_due_mail_template" model="mail.template">
            <field name="name">Invoice: Due Reminder Email</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="email_from">a.mezzi@Kripton.fr</field>
            <field name="email_to">a.mezzi@Kripton.fr,r.alouani@sapres.de,s.benyedder@sapres.de,e.karoui@sapres.de
            </field>
            <field name="subject">Reminder for {{ object.name }} Expiration</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <h4>
                            <b>Dear salim,</b>
                        </h4>
                        <br/>
                        Invoice -
                        <b>
                            <t t-out="object.name"/>
                        </b>
                        is going to expire.
                        The due date is on
                        <b>
                            <t t-out="object.invoice_date_due"/>
                        </b>
                        .
                        <br/>
                        Please take necessary actions.
                        <br/>
                        <br/>
                        <b>More details of Invoice
                            <t t-out="object.name"/>
                        </b>
                        :
                        <br/>
                        Invoice Name :
                        <t t-out="object.name"/>
                        <br/>
                        Created Date :
                        <t t-out="object.invoice_date"/>
                        <br/>
                        Partner Name :
                        <t t-out="object.partner_id.name"/>
                        <br/>
                        Total Order Amount :
                        <t t-out="object.amount_total"/>
                        <br/>
                        Amount Paid :
                        <t t-out="object.amount_paid"/>
                        <br/>
                        Amount Due :
                        <t t-out="object.amount_residual"/>
                        <br/>
                        <br/>
                    </p>
                </div>
            </field>
        </record>
        <record id="client_contract_due_mail_template" model="mail.template">
            <field name="name">Client Contracts: Due Reminder Email</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="email_from">a.mezzi@Kripton.fr</field>
            <field name="email_to">a.mezzi@Kripton.fr,r.alouani@sapres.de,s.benyedder@sapres.de,e.karoui@sapres.de
            </field>
            <field name="subject">Reminder for Client Contracts: 30 day(s) before End Date</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 16px;">
                        <h4>
                            <b>Selim Ben Yedder, you asked to be reminded 30 day(s) before End Date for the following
                                items:
                            </b>
                        </h4>
                        <h5>
                            <br/>
                            Client Contracts :
                            <t t-out="object.name"/>
                            <br/>
                            Customer :
                            <t t-out="object.partner_id.name"/>
                            <br/>

                            <!-- Gestion des multiples lignes de commande -->
                            Consultants :
                            <ul>
                                <t t-foreach="object.order_line" t-as="line">
                                    <li>
                                        <t t-esc="line.vendor_id.name"/>
                                    </li>
                                </t>
                            </ul>
                        </h5>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
