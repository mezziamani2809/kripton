<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_stornorechnungs_report_print_thermal_so" model="ir.actions.report">
        <field name="name">Stornorechnung</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stornorechnungs_report.report_stornorechnung</field>
        <field name="report_file">stornorechnungs_report.report_stornorechnung</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_type">report</field>
    </record>
    <template id="rechnung_external_layout_standard">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <!-- Multicompany -->
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>

            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
            <div class="row">
                <div style="padding-top: 40px;">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                         style="max-height: 50px;  width: 200px;" alt="Logo"/>
                </div>
                <div style="padding-top: 40px; margin-left: 150px">

                </div>
                <div class="col-3 text-right" style="margin-top:22px;" t-field="company.report_header" name="moto"/>
            </div>
            <div class="row" style="padding-top: 20px;">
                <div style="font-size:12px">
                    <t t-if="company.name">
                        <span t-field="company.name"/>
                    </t>
                    <br/>
                    <t t-if="company.street">
                        <span t-field="company.street"/>
                    </t>
                    <br/>
                    <t t-if="company.street2">
                        <span t-field="company.street2"/>
                    </t>
                    <t t-if="company.zip">
                        <span t-field="company.zip"/>
                    </t>
                    <t t-if="company.city">
                        <span t-field="company.city"/>
                    </t>

                </div>

                <table style="width:100%; margin-left: 10px border-left: 1px; solid black; table-layout: fixed;">
                    <colgroup>
                        <col style="width: 40%;"/>
                        <col style="width: 60%;"/>
                    </colgroup>
                    <tr>

                        <th>
                        </th>
                        <th>
                            <h4>
                                <div>
                                    <b style="font-size:20px">Stornorechnung :</b>
                                    <b t-field="o.invoice_number" style="font-size:20px"/>
                                </div>

                            </h4>
                        </th>
                    </tr>
                </table>


            </div>

        </div>
        <div t-attf-class="din_page invoice_note article o_company_#{company.id}_layout"
             t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
            <h3>
                <br/>
            </h3>
            <table style="width:100%; margin-left: 10px border-left: 1px solid black; table-layout: fixed;">
                <colgroup>
                    <col style="width: 20%;"/>
                    <col style="width: 30%;"/>
                    <col style="width: 25%;"/>
                    <col style="width: 25%;"/>
                </colgroup>
                <tr>
                    <th>
                        <b>Kunde :</b>
                    </th>
                    <th>
                        <span t-field="o.partner_id.name"/>
                    </th>
                    <th>Stornorechnung für die Rechnung Nr:</th>
                    <th>
                        <span t-field="o.ref_number"/>
                    </th>
                </tr>
                <tr>
                    <th></th>
                    <th>
                    </th>
                    <th>Datum :</th>
                    <th>
                        <t t-if="o.invoice_date">
                            <span t-field="o.invoice_date"/>
                        </t>
                    </th>
                </tr>
                <tr>
                    <th>Kontakt :</th>
                   <th>
                        <span t-field="o.contact_id.name"/>
                    </th>

                    <th>
                        <b>E-mail :</b>
                    </th>
                    <th>
                        <span>accounting@sapres.de</span>
                    </th>
                </tr>
                <tr>
                    <th>
                        <b>Adresse :</b>
                    </th>
                    <th>
                        <t t-if="o.partner_id.street">
                            <span t-field="o.partner_id.street"/>
                        </t>
                        <br/>
                        <t t-if="o.partner_id.street2">
                            <span t-field="o.partner_id.street2"/>
                        </t>
                        <t t-if="o.partner_id.zip">
                            <span t-field="o.partner_id.zip"/>
                        </t>
                        <t t-if="o.partner_id.city">
                            <span t-field="o.partner_id.city"/>
                        </t>
                    </th>
                    <th>
                        <b>Tel :</b>
                        <br/>
                        <b>USt-IdNr :</b>
                    </th>
                    <th>
                        <span>+49 6134 50796 -301</span>
                        <br/>
                        <span>DE321097474</span>

                    </th>
                </tr>

            </table>

            <h2>
                <br/>
            </h2>
            <t t-out="0"/>
        </div>
        <div t-attf-class="din_page footer o_company_#{company.id}_layout"
             style="padding-left: 1mm; padding-right: 1mm;">
            <div class="company_details">
                <h2>
                    <br/>
                </h2>
                <table style="width:100%; margin-left: 10px border-left: 1px">
                    <tr>
                        <th>
                            <ul class="list-inline">
                                <li t-if="company.name">
                                    <span t-field="company.name"/>
                                </li>
                                <li t-if="company.street">
                                    <span t-field="company.street"/>
                                </li>
                                <li>
                                    <span t-field="company.street2"/>
                                    <span t-if="company.zip" t-field="company.zip"/>
                                    <span t-if="company.city" t-field="company.city"/>
                                </li>

                            </ul>
                        </th>
                        <th>
                            <ul class="list-inline">

                                <li t-if="company.phone">
                                    <span style="text-align: center;">PostBank</span>
                                </li>

                                <li t-if="company.iban">
                                    <span>IBAN :</span>
                                    <span t-field="company.iban"/>
                                </li>
                                <li t-if="company.bic">
                                    <span>BIC SWIFT :</span>
                                    <span t-field="company.bic"/>
                                </li>
                            </ul>
                        </th>
                        <th>
                            <ul class="list-inline">
                                <li t-if="company.vat"><t
                                        t-esc="company.account_fiscal_country_id.vat_label or 'Tax ID'"/>:
                                    <span t-field="company.vat"/>
                                </li>
                                <li>USt-IdNr:
                                    <span>DE321097474</span>
                                </li>
                                <div t-field="company.report_footer"/>
                            </ul>
                        </th>
                    </tr>
                </table>

            </div>
        </div>
    </template>
    <template id="tax_groups_totals">
        <!--
            Generic template to display a list of tax groups with the related amounts.

            ARGUMENTS:
            - tax_totals: dict in the form generated by account.move's _get_tax_totals.
            - subtotal_to_show: The subtotal we need to render the groups from
        -->
    </template>


    <template id="report_stornorechnung">
        <t t-call="web.html_container">
            <t t-call="stornorechnungs_report.rechnung_external_layout_standard">
                <t t-foreach="docs" t-as="doc">
                    <link rel="stylesheet"
                          href="/thermal_invoice_report/static/src/css/thermal_style.css"/>
                    <div class="pages">

                        <table class="table table-sm o_main_table" name="invoice_line_table">
                            <thead>
                                <tr>
                                    <th name="th_description" class="text-left">
                                        <span>Beschreibung</span>
                                    </th>
                                    <th name="th_service_type" class="text-left">
                                        <span></span>
                                    </th>
                                    <th name="th_service_type" class="text-left">
                                        <span>Consultant</span>
                                    </th>
                                    <th name="th_service_type" class="text-left">
                                        <span>leistungszeitraum</span>
                                    </th>
                                    <th name="th_quantity" class="text-right">
                                        <span>Einheit</span>
                                    </th>
                                    <th name="th_quantity" class="text-right">
                                        <span>Menge</span>
                                    </th>
                                    <th name="th_priceunit"
                                        t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span>Einzelpreis</span>
                                    </th>
                                    <th name="th_subtotal" class="text-right">
                                        <span groups="account.group_show_line_subtotals_tax_excluded">Betrag</span>
                                        <span groups="account.group_show_line_subtotals_tax_included">Gesamtpreis</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <t t-set="current_subtotal" t-value="0"/>
                                <t t-set="lines"
                                   t-value="docs.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                                <t t-foreach="lines" t-as="line">
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                                       groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                                       groups="account.group_show_line_subtotals_tax_included"/>

                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                        <t t-if="not line.display_type" name="account_invoice_line_accountable">
                                            <td name="account_invoice_line_name">
                                                <span t-field="line.product_id.name" t-options="{'widget': 'text'}"/>
                                            </td>
                                            <td name="account_invoice_line_name">
                                                <t t-if="line.service_type == 'site'">
                                                    <span>On Site</span>
                                                </t>
                                                <t t-if="line.service_type == 'romote'">
                                                    <span>Remote</span>

                                                </t>
                                            </td>
                                            <td name="account_invoice_line_name">
                                                <t>
                                                    <span t-field="line.end_date.name"/>
                                                </t>
                                            </td>
                                            <td name="account_invoice_line_name">
                                                <span t-field="line.start_date"
                                                      t-options='{"format": "MMM"}'/>. &#160;<span t-field="line.start_date"
                                                      t-options='{"format": "Y"}'/>
                                            </td>
                                            <td class="text-right">
                                                <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                            </td>
                                            <td class="text-right">
                                                <span t-field="line.quantity"/>
                                            </td>
                                            <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                               <span>€&#160;</span><span class="text-nowrap" t-field="line.price_unit"/>
                                            </td>
                                            <td class="text-right o_price_total">
                                                <span class="text-nowrap" t-field="line.price_subtotal"
                                                      groups="account.group_show_line_subtotals_tax_excluded"/>
                                                <span class="text-nowrap" t-field="line.price_total"
                                                      groups="account.group_show_line_subtotals_tax_included"/>
                                            </td>
                                        </t>
                                        <t t-if="line.display_type == 'line_section'">
                                            <td colspan="99">
                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                            </td>
                                            <t t-set="current_section" t-value="line"/>
                                            <t t-set="current_subtotal" t-value="0"/>
                                        </t>
                                        <t t-if="line.display_type == 'line_note'">
                                            <td colspan="99">
                                                <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                            </td>
                                        </t>
                                    </tr>


                                    <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                        <tr class="is-subtotal text-right">
                                            <td colspan="99">
                                                <strong class="mr16">Zwischensumme</strong>
                                                <span
                                                        t-esc="current_subtotal"
                                                        t-options='{"widget": "monetary", "display_currency": docs.currency_id}'
                                                />
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                        <div class="clearfix">
                            <div id="total" class="row">
                                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">
                                    <table class="table table-sm" style="page-break-inside: avoid;">

                                        <!--Tax totals-->
                                        <t t-set="tax_totals" t-value="json.loads(docs.tax_totals_json)"/>
                                        <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                                            <tr class="border-black o_subtotal">
                                                <td>
                                                    <!--                                                    <strong t-esc="subtotal['name']"/>-->
                                                    <span>Netto</span>
                                                </td>

                                                <td class="text-right">
                                                    <span
                                                            t-att-class="oe_subtotal_footer_separator"
                                                            t-esc="subtotal['formatted_amount']"
                                                    />
                                                </td>
                                            </tr>
                                            <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
                                            <t t-foreach="tax_totals['groups_by_subtotal'][subtotal_to_show]"
                                               t-as="amount_by_group">
                                                <tr>
                                                    <t t-if="len(tax_totals['groups_by_subtotal'][subtotal_to_show]) > 1 or (tax_totals['amount_untaxed'] != amount_by_group['tax_group_base_amount'])">


                                                    </t>
                                                    <t t-else="">
                                                        <td>
                                                            <span class="text-nowrap"
                                                                  t-esc="amount_by_group['tax_group_name']"/>
                                                        </td>
                                                        <td class="text-right o_price_total">
                                                            <span class="text-nowrap"
                                                                  t-esc="amount_by_group['formatted_tax_group_amount']"/>
                                                        </td>
                                                    </t>
                                                </tr>
                                            </t>
                                        </t>
                                        <t t-call="stornorechnungs_report.tax_groups_totals"/>
                                        <!--Total amount with all taxes-->
                                        <tr class="border-black o_total">
                                            <tr class="border-black o_total">
                                                <td>
                                                    <strong>Gesamt</strong>
                                                </td>
                                                <td class="text-right">
                                                    <span t-field="docs.amount_total_signed"/>
                                                </td>
                                            </tr>
                                            <tr class="border-black o_total" t-if="doc.discount_amount != 0">
                                                <td>
                                                    <strong>Skonto</strong>
                                                    <span t-field="docs.discount_amount"/>%

                                                </td>
                                                <td class="text-right">
                                                    <span t-field="docs.total_discount"/>
                                                    <span t-field="docs.currency_id.symbol"/>
                                                </td>
                                            </tr>
                                            <td>
                                                <strong t-if="doc.discount_amount != 0">Gesamt mit skonto</strong>
                                            </td>
                                            <td class="text-right" t-if="doc.discount_amount != 0">
                                                <span t-esc="tax_totals['formatted_amount_total']"/>
                                            </td>
                                        </tr>


                                        <!--Payments-->
                                        <t t-if="print_with_payments">
                                            <t t-if="docs.payment_state != 'invoicing_legacy'">
                                                <t t-set="payments_vals"
                                                   t-value="docs.sudo()._get_reconciled_info_JSON_values()"/>
                                                <t t-foreach="payments_vals" t-as="payment_vals">
                                                    <tr>
                                                        <td>
                                                            <i class="oe_form_field text-right oe_payment_label">Bezahlt
                                                                am
                                                                <t t-esc="payment_vals['date']"
                                                                   t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                                                            </i>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-esc="payment_vals['amount']"
                                                                  t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                                <t t-if="len(payments_vals) &gt; 0">
                                                    <tr class="border-black">
                                                        <td>
                                                            <strong>Fälliger Betrag</strong>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-field="docs.amount_residual"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>
                                    </table>

                                    <br/>

                                </div>
                            </div>
                        </div>
                        <br/>
                        <br/>
                         <p t-if="not docs.amount_tax" style="background-color: #F2F2F2;">Steuerschuldner der
                            Umsatzsteuer ist gemäß §13b UStG der Leistungsempfänger.
                        </p>
                        <br/>
                        <br/>
                        <p t-if="docs.move_type in ('out_invoice', 'in_refund') and docs.payment_reference"
                           name="payment_communication">

                            Bitte den Rechnungsbetrag innerhalb von
                            <b>
                                <span t-field="docs.invoice_payment_term_id.line_ids.days"/>
                            </b>
                            Tage zu diesen Bankdaten überweisen:
                        </p>

                        <table>
                            <tr>
                                <th>
                                    Firma :
                                    <br/>
                                    Bank :
                                    <br/>
                                    IBAN :
                                    <br/>
                                    BIC :
                                </th>
                                <th>
                                    <span t-field="docs.company_id.name"/>
                                    <br/>
                                    <span t-field="docs.company_id.bank"/>
                                    <br/>
                                    <span t-field="docs.company_id.iban"/>
                                    <br/>
                                    <span t-field="docs.company_id.bic"/>
                                </th>
                            </tr>
                        </table>
                        <table style="width:100%; border-left: 1px;">
                            <tr>
                                <th style="width:30%; border-left: 1px;">
                                    <h2>
                                        <br/>
                                    </h2>
                                </th>
                                <th style="width:30%; border-left: 1px;">
                                    <h2>
                                        <br/>
                                    </h2>
                                </th>

                            </tr>


                        </table>
                    </div>

                </t>
            </t>
        </t>
    </template>


</odoo>
