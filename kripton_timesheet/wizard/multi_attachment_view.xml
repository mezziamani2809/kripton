<?xml version="1.0"?>
<odoo>
    <record model='ir.ui.view' id='accountanalyticlinewizard_form_view'>
        <field name="name">sapres.account.analytic.line.wizard.form</field>
        <field name="model">account.analytic.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Attachment">
                <field name="timesheet_ids" mode="tree">
                    <tree editable="bottom" string="Timesheet Activities" default_order="date">
                        <field name="date"/>
                        <field name="end_date"/>
                        <field name="consultant_id" invisible="1"/>
                        <field name="project_id"/>
                        <field name="task_id"/>
                        <field name="name" required="0" invisible="1"/>
                        <field name="unit_amount" widget="timesheet_uom"
                               decoration-danger="unit_amount &gt; 24" string="Hours Spent"/>
                        <field name="company_id" invisible="1"/>
                    </tree>
                </field>

                <group>
                    <group>
                        <field name="invoice_attachment" class="oe_inline" filename="invoice_name"
                               widget="drag_and_drop"/>
                        <field name="invoice_name" invisible="1"/>
                    </group>
                    <group>
                        <field name="timesheet_attachment" class="oe_inline" filename="timesheet_name"
                               widget="drag_and_drop"/>
                        <field name="timesheet_name" invisible="1"/>
                    </group>

                </group>
                <footer>
                    <button string="Add Timesheets" type="object" name="add_attachment_all_" class="btn btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>

            </form>
        </field>
    </record>
    <record id="accountanalyticlinewizard" model="ir.actions.act_window">
        <field name="name">My Timesheets</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.analytic.line.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="kripton_timesheet.accountanalyticlinewizard_form_view"/>
        <field name="target">new</field>
    </record>


</odoo>