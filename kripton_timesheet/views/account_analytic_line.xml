<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_timesheet_line_form_" model="ir.ui.view">
        <field name="name">account.analytic.line.view.tree.quotation</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='date']" position="after">
                <field name="end_date"/>
            </xpath>
            <xpath expr="//field[@name='unit_amount']" position="after">
                <field name="consultant_id" invisible="1"/>
                <field name="state" invisible="1"/>

                <field name="timesheet_attachment" class="oe_inline" filename="timesheet_name" widget="drag_and_drop"/>
                <field name="timesheet_name" invisible="1"/>

            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="required">0</attribute>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="invoice_attachment" class="oe_inline" filename="invoice_name" widget="drag_and_drop"/>
                <field name="invoice_name" invisible="1"/>
            </xpath>
        </field>
    </record>
    <record id="timesheet_view_tree_quotation" model="ir.ui.view">
        <field name="name">account.analytic.line.view.tree.quotation</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
        <field name="arch" type="xml">
            <!--  <xpath expr="//tree" position="attributes">
                  <attribute name="delete">false</attribute>
                  <attribute name="js_class">saleorder_btn_tree</attribute>

              </xpath>-->

           <!-- <xpath expr="//field[@name='date']" position="before">
                <header>
                    <button name="action_to_check" string="Check"
                            type="object" groups="hr_timesheet.group_hr_timesheet_approver"/>
                </header>
            </xpath>-->
            <xpath expr="//field[@name='unit_amount']" position="attributes">
                <attribute name="readonly">0</attribute>
                                <attribute name="invisible">0</attribute>

            </xpath>
            <xpath expr="//field[@name='employee_id']" position="before">
                <field name="end_date"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="required">0</attribute>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='task_id']" position="after">
                <field name="timesheet_attachment" class="oe_inline" filename="timesheet_name" widget="drag_and_drop"/>
                <field name="timesheet_name" invisible="1"/>
                <field name="invoice_name" invisible="1"/>
                <field name="invoice_attachment" class="oe_inline" filename="invoice_name" widget="drag_and_drop"/>
            </xpath>
        </field>
    </record>
    <record id="project_task_view_form_inherit_sale_timesheet_editable_quotation" model="ir.ui.view">
        <field name="name">project.task.form.view.form.inherit.sale.timesheet.quotation</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='timesheet_ids']/tree/field[@name='unit_amount']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/tree/field[@name='date']" position="after">
                <field name="end_date"/>
                <field name="is_employee" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/tree/field[@name='unit_amount']" position="after">
                <field name="task_id" optional="show" options="{'no_create_edit': True, 'no_open': True}"
                       widget="task_with_hours" context="{'default_project_id': project_id}"
                       domain="[('project_id', '=', project_id)]"/>
                <field name="consultant_id" context="{'res_partner_search_mode': 'supplier', 'show_vat': True}"
                       attrs="{'invisible': [('is_employee', '=', True)]}"/>
                <field name="timesheet_attachment" class="oe_inline" filename="timesheet_name" widget="drag_and_drop"/>
                <field name="timesheet_name" invisible="1"/>
                <field name="invoice_name" invisible="1"/>
                <field name="invoice_attachment" class="oe_inline" filename="invoice_name" widget="drag_and_drop"/>
                <field name="unit_amount_on_site" optional="show" widget="timesheet_uom" sum="Total"
                       decoration-danger="unit_amount_on_site &gt; 24" invisible="1"/>
                <field name="unit_amount_on_remote" optional="show" widget="timesheet_uom" sum="Total"
                       decoration-danger="unit_amount_on_remote &gt; 24" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/tree/field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>
    <record id="timesheet_view_tree_user_" model="ir.ui.view">
        <field name="name">account.analytic.line.view.tree.quotation</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.timesheet_view_tree_user"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='unit_amount']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="required">0</attribute>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="before">
                <field name="consultant_id" context="{'res_partner_search_mode': 'supplier', 'show_vat': True}"/>
            </xpath>
           <!-- <xpath expr="//field[@name='unit_amount']" position="before">
                <field name="state" widget="badge" decoration-success="state == 'checked'"
                       decoration-info="state == 'check'" optional="show"/>
            </xpath>-->
        </field>
    </record>
    <record id="hr_timesheet.act_hr_timesheet_line" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>
    <record id="hr_timesheet.timesheet_action_all" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>
